# Use a lightweight Python environment based on Linux.
FROM python:3.12-slim

# Set the working directory inside the container.
WORKDIR /app

# Prevent Python from generating unnecessary bytecode files.
ENV PYTHONDONTWRITEBYTECODE=1

# Display Python output immediately without buffering.
ENV PYTHONUNBUFFERED=1

# Configure the port used by the HTTP router.
ENV PORT=8080

# Configure the backend servers on the Docker network.
ENV KV_NODES=kv1,kv2,kv3

# Configure the internal HTTP port used by each backend.
ENV KV_BACKEND_PORT=8080

# Copy dependencies separately to support Docker layer caching.
COPY requirements.txt ./

# Install the required HTTP libraries without retaining
# downloaded package caches.
RUN python -m pip install --no-cache-dir -r requirements.txt

# Copy the asynchronous HTTP routing application.
COPY router_docker.py ./

# Copy the SHA-256 consistent hashing implementation.
COPY consistent_hash.py ./

# Document the router's internal HTTP port.
EXPOSE 8080

# Start the distributed HTTP router.
CMD ["python", "router_docker.py"]